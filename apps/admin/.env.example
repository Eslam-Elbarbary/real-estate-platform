# Public URLs (safe to expose to the browser)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-only data source switch: mock | api
# Defaults to mock when unset.
ADMIN_DATA_SOURCE=api

# On-demand public web cache invalidation (must match apps/web REVALIDATE_SECRET)
REVALIDATE_SECRET=dev-revalidate-secret
# Public web origin used by admin server actions to call /api/revalidate
WEB_APP_URL=http://localhost:3000
