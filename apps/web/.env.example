# ─── Required for production ───────────────────────────────────────────────
# Backend API base URL (no trailing slash). Used by server/client data fetching.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public site URL (canonical origin for SEO/metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared with admin for on-demand ISR revalidation (POST /api/revalidate)
REVALIDATE_SECRET=dev-revalidate-secret

# ─── Optional marketing / app links ────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_PLAY_URL=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_SUPPORT_WHATSAPP=201000000000
